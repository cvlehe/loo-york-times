NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Browser-safe MapTiler key used to render the public directory map.
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key

# Server-only. Used by the one-off CSV importer; never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public GA4 Measurement ID. Custom events are disabled when absent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
